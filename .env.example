# Recommended: paste the complete Cookie request-header value from meta.ai.
# Accepted formats: "datr=...; ecto_1_sess=...; ...", a JSON object, or a
# Cookie-Editor JSON array export.
META_AI_COOKIE=

# Legacy fallback if you prefer separate values:
META_AI_DATR=
META_AI_ECTO_1_SESS=
META_AI_ABRA_SESS=

META_AI_ACCESS_TOKEN=
META_AI_API_KEY=replace_with_a_long_random_secret
META_AI_HEADED=false
META_AI_MAX_UPLOAD_BYTES=15728640
META_AI_UPLOAD_DIR=/tmp/metaai-uploads
HOST=0.0.0.0
PORT=8000
